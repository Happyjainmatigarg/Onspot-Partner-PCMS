# OnSpot Ecosystem - Production Environment Variables
# Copy this file to .env and fill in the values

# === DATABASE ===
# MongoDB Atlas connection string (recommended for production)
MONGO_PASSWORD=your-secure-mongodb-password
# Or use MONGODB_URI directly for Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/onspot_ecosystem

# === SECURITY ===
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-generate-with-openssl

# === EMAIL (Gmail SMTP) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=onspotac@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=partner@onspot.one

# === APP URLS (Production Domains) ===
PARTNER_APP_URL=https://partner.onspot.one
CUSTOMER_APP_URL=https://customer.onspot.one
ADMIN_APP_URL=https://admin.onspot.one
BACKEND_URL=https://api.onspot.one

# === CORS ===
CORS_ORIGINS=https://partner.onspot.one,https://customer.onspot.one,https://admin.onspot.one

# === OTP Provider (Choose one) ===

# Option 1: MSG91 (Recommended for India)
#MSG91_API_KEY=
#MSG91_SENDER_ID=ONSPOT
#MSG91_TEMPLATE_ID=

# Option 2: Twilio (International)
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_PHONE_NUMBER=

# Option 3: Fonoster (Voice OTP)
#FONOSTER_ACCESS_KEY_ID=
#FONOSTER_API_KEY=
#FONOSTER_API_SECRET=
#FONOSTER_FROM_NUMBER=

# === OPTIONAL SERVICES ===

# AWS S3 (for PDF certificate storage)
#AWS_S3_BUCKET=onspot-documents
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=ap-south-1

# Redis (for session/OTP caching)
#REDIS_URL=redis://localhost:6379
