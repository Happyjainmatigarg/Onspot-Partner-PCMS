# Backend Environment Variables

# Database
MONGODB_URI=mongodb://localhost:27017/onspot_ecosystem

# JWT
JWT_SECRET=onspot-jwt-secret-change-in-production-use-openssl-rand-base64-64

# Server
PORT=3000
NODE_ENV=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# App URLs (for emails)
PARTNER_APP_URL=http://localhost:3001
CUSTOMER_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3003

# AWS S3 (optional - for PDF storage)
#AWS_S3_BUCKET=onspot-documents
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=ap-south-1

# Redis (optional - for production OTP)
#REDIS_URL=redis://localhost:6379

# Fonoster (optional - for voice OTP)
#FONOSTER_ACCESS_KEY_ID=
#FONOSTER_API_KEY=
#FONOSTER_API_SECRET=
#FONOSTER_FROM_NUMBER=
#FONOSTER_APP_REF=
