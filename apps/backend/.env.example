# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/onspot_ecosystem

# Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,https://partner.onspot.one,https://customer.onspot.one,https://onspotapp.onspot.one

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="OnSpot Ecosystem <noreply@onspot.one>"

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Admin Configuration
SUPER_ADMIN_EMAIL=admin@onspot.one
SUPER_ADMIN_PASSWORD=Admin@123
